# Backend origin reachable from your emulator/device, without /api/v1.
# Example for the Android emulator: http://10.0.2.2:8000
# EXPO_PUBLIC_ values are embedded in the app; never put secrets here.
EXPO_PUBLIC_API_URL=

# Blank: Basic in development builds, Clerk in release builds.
# Override with clerk to test the Clerk flow in a development build.
# Basic credentials are entered at runtime; never put them in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_AUTH_MODE=

# Public key from Clerk > API keys. This is NOT the backend CLERK_SECRET_KEY.
# Pilot: development instance pk_test_...; production: pk_live_... (app#7).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dXNlZnVsLXN0YXJsaW5nLTI1NjguY2xlcmsuYWNjb3VudHMuZGV2JA
