{
  "id": "hammer_curl",
  "version": 2,
  "catalog": "hammer-curl",
  "name": {
    "es": "Curl martillo",
    "en": "Hammer curl"
  },
  "view": "side",
  "side_joints": ["shoulder", "elbow", "wrist", "hip"],
  "camera": {
    "es": "De lado, con el brazo que trabaja hacia el móvil y del hombro a la cadera en el encuadre.",
    "en": "Side-on, working arm toward the phone, shoulder to hip in frame."
  },
  "required": ["shoulder", "elbow", "wrist"],
  "signals": {
    "elbow": {
      "type": "angle",
      "points": ["shoulder", "elbow", "wrist"]
    },
    "upper_arm": {
      "type": "angle",
      "points": ["hip", "shoulder", "elbow"],
      "baseline": "rest"
    },
    "trunk": {
      "type": "inclination",
      "points": ["hip", "shoulder"]
    },
    "wrist_height": {
      "type": "height",
      "point": "wrist",
      "scale": ["hip", "shoulder"]
    }
  },
  "rep": {
    "signal": "elbow",
    "rest": "high",
    "start_delta": 35,
    "end_delta": 30,
    "min_rom": 35,
    "min_duration": 0.6,
    "max_duration": 8.0,
    "idle_end_s": 6.0
  },
  "metrics": {
    "top": {
      "signal": "elbow",
      "phase": "rep",
      "agg": "min"
    },
    "extension": {
      "signal": "elbow",
      "phase": "end_window",
      "agg": "max"
    },
    "drift": {
      "signal": "upper_arm",
      "phase": "rep",
      "agg": "max"
    },
    "swing": {
      "signal": "trunk",
      "phase": "rep",
      "agg": "range"
    },
    "lower_time": {
      "type": "recovery_time",
      "signal": "elbow",
      "fraction": 0.8
    },
    "lift_speed": {
      "type": "mean_speed",
      "signal": "wrist_height",
      "phase": "out"
    }
  },
  "criteria": [
    {
      "id": "top",
      "metric": "top",
      "ideal_max": 65.0,
      "tolerance": 35.0,
      "weight": 0.35,
      "severity": "invalidates",
      "points": ["shoulder", "elbow", "wrist"],
      "unit": "deg"
    },
    {
      "id": "extension",
      "metric": "extension",
      "ideal_min": 150.0,
      "tolerance": 25.0,
      "weight": 0.15,
      "severity": "technique",
      "points": ["shoulder", "elbow", "wrist"],
      "unit": "deg"
    },
    {
      "id": "drift",
      "metric": "drift",
      "ideal_max": 15.0,
      "tolerance": 20.0,
      "weight": 0.25,
      "severity": "technique",
      "points": ["hip", "shoulder", "elbow"],
      "unit": "deg",
      "disabled": true
    },
    {
      "id": "swing",
      "metric": "swing",
      "ideal_max": 10.662,
      "tolerance": 12.0,
      "weight": 0.15,
      "severity": "technique",
      "points": ["hip", "shoulder"],
      "unit": "deg"
    },
    {
      "id": "tempo",
      "metric": "lower_time",
      "ideal_min": 0.543,
      "tolerance": 0.5,
      "weight": 0.1,
      "severity": "detail",
      "points": ["shoulder", "elbow", "wrist"],
      "unit": "s"
    }
  ],
  "effort_metric": "lift_speed",
  "cues": {
    "top": {
      "label": {
        "es": "la subida",
        "en": "the top"
      },
      "trend": {
        "es": "dejaste de subir del todo",
        "en": "you stopped curling all the way"
      },
      "live": {
        "es": "Arriba del todo",
        "en": "All the way up"
      },
      "fix": {
        "es": "Sube hasta que la mancuerna llegue a la altura del hombro.",
        "en": "Curl until the dumbbell reaches shoulder height."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones el codo solo se cerró hasta ~{value}°.",
        "en": "In {n} of {total} reps your elbow only closed to ~{value}°."
      },
      "good": {
        "es": "Subiste del todo en cada repetición.",
        "en": "You curled all the way up on every rep."
      }
    },
    "extension": {
      "label": {
        "es": "la bajada",
        "en": "the bottom"
      },
      "trend": {
        "es": "dejaste de estirar el brazo",
        "en": "you stopped straightening your arm"
      },
      "live": {
        "es": "Brazo largo abajo",
        "en": "Long arm at the bottom"
      },
      "fix": {
        "es": "Estira el brazo del todo antes de volver a subir.",
        "en": "Straighten your arm fully before curling again."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones no estiraste el brazo abajo (~{value}°).",
        "en": "In {n} of {total} reps you didn't straighten your arm at the bottom (~{value}°)."
      },
      "good": {
        "es": "Estiraste el brazo del todo en cada repetición.",
        "en": "You straightened your arm on every rep."
      }
    },
    "drift": {
      "label": {
        "es": "el codo",
        "en": "your elbow"
      },
      "trend": {
        "es": "el codo se fue hacia delante",
        "en": "your elbow drifted forward"
      },
      "live": {
        "es": "Codo pegado",
        "en": "Elbow tucked"
      },
      "fix": {
        "es": "Deja el codo quieto junto al cuerpo; solo se mueve el antebrazo.",
        "en": "Keep your elbow still by your side; only your forearm moves."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones el codo se adelantó ~{value}°.",
        "en": "In {n} of {total} reps your elbow moved forward ~{value}°."
      },
      "good": {
        "es": "El codo se quedó quieto en todas las repeticiones.",
        "en": "Your elbow stayed still on every rep."
      }
    },
    "swing": {
      "label": {
        "es": "el balanceo",
        "en": "swinging"
      },
      "trend": {
        "es": "empezaste a balancear el cuerpo",
        "en": "you started swinging"
      },
      "live": {
        "es": "Tronco quieto",
        "en": "Still torso"
      },
      "fix": {
        "es": "No te eches hacia atrás para subir: si hace falta, baja el peso.",
        "en": "Don't lean back to lift it: drop the weight if you need to."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones el tronco se balanceó ~{value}°.",
        "en": "In {n} of {total} reps your torso swung ~{value}°."
      },
      "good": {
        "es": "Mantuviste el tronco quieto en toda la serie.",
        "en": "You kept your torso still all set."
      }
    },
    "tempo": {
      "label": {
        "es": "el ritmo de bajada",
        "en": "your lowering"
      },
      "trend": {
        "es": "bajaste más rápido",
        "en": "you lowered faster"
      },
      "live": {
        "es": "Baja en dos",
        "en": "Two counts down"
      },
      "fix": {
        "es": "Cuenta «uno, dos» mientras bajas.",
        "en": "Count «one, two» on the way down."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones bajaste en ~{value} s.",
        "en": "In {n} of {total} reps you lowered in ~{value} s."
      },
      "good": {
        "es": "Bajaste con control en todas las repeticiones.",
        "en": "You lowered with control on every rep."
      }
    }
  },
