{
  "id": "seated_shoulder_press",
  "version": 2,
  "catalog": "seated-shoulder-press",
  "name": {
    "es": "Press militar sentado",
    "en": "Seated shoulder press"
  },
  "view": "side",
  "side_joints": ["shoulder", "elbow", "wrist", "hip"],
  "camera": {
    "es": "De lado, con el móvil a la altura del pecho y los brazos estirados dentro del encuadre.",
    "en": "Side-on, phone at chest height, arms fully extended still in frame."
  },
  "required": ["shoulder", "wrist", "hip"],
  "signals": {
    "press": {
      "type": "relative_height",
      "points": ["shoulder", "wrist"],
      "scale": ["hip", "shoulder"]
    },
    "stack": {
      "type": "forward_offset",
      "points": ["wrist", "shoulder"],
      "scale": ["hip", "shoulder"]
    },
    "trunk": {
      "type": "inclination",
      "points": ["hip", "shoulder"]
    }
  },
  "rep": {
    "signal": "press",
    "rest": "low",
    "start_delta": 0.5,
    "end_delta": 0.4,
    "min_rom": 0.45,
    "near": 0.03,
    "min_duration": 0.6,
    "max_duration": 8.0
  },
  "metrics": {
    "lockout": {
      "signal": "press",
      "phase": "rep",
      "agg": "max"
    },
    "depth": {
      "signal": "press",
      "phase": "end_window",
      "agg": "min"
    },
    "stack": {
      "signal": "stack",
      "phase": "rep",
      "agg": "max"
    },
    "arch": {
      "signal": "trunk",
      "phase": "rep",
      "agg": "range"
    },
    "lower_time": {
      "type": "recovery_time",
      "signal": "press",
      "fraction": 0.8
    },
    "press_speed": {
      "type": "mean_speed",
