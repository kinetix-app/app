{
  "id": "push_up",
  "catalog": "push-up",
  "version": 2,
  "name": {
    "es": "Flexiones",
    "en": "Push-ups"
  },
  "view": "side",
  "signals": {
    "elbow": {
      "type": "angle",
      "points": ["shoulder", "elbow", "wrist"]
    },
    "body_line": {
      "type": "line_offset",
      "points": ["hip", "shoulder", "ankle"]
    },
    "shoulder_height": {
      "type": "height",
      "point": "shoulder",
      "scale": ["shoulder", "ankle"]
    }
  },
  "rep": {
    "signal": "elbow",
    "rest": "high",
    "start_delta": 20,
    "end_delta": 10,
    "min_rom": 30,
    "min_duration": 0.5,
    "max_duration": 8.0
  },
  "metrics": {
    "depth": {
      "signal": "elbow",
      "phase": "rep",
      "agg": "min"
    },
    "sag": {
      "signal": "body_line",
      "phase": "rep",
      "agg": "max"
    },
    "pike": {
      "signal": "body_line",
      "phase": "rep",
      "agg": "min"
    },
    "lockout": {
      "signal": "elbow",
      "phase": "end_window",
      "agg": "max"
    },
    "descent_time": {
      "type": "duration",
      "phase": "out"
    },
    "ascent_speed": {
      "type": "mean_speed",
      "signal": "shoulder_height",
      "phase": "return"
    }
  },
  "criteria": [
    {
      "id": "depth",
      "metric": "depth",
      "ideal_max": 112.359,
      "tolerance": 30.0,
      "weight": 0.4,
      "severity": "invalidates",
      "points": ["shoulder", "elbow", "wrist"],
      "unit": "deg"
    },
    {
      "id": "sag",
      "metric": "sag",
      "ideal_max": 0.031,
      "tolerance": 0.07,
      "weight": 0.3,
      "severity": "technique",
      "points": ["hip", "shoulder", "ankle"],
      "unit": "scale",
      "scale": ["shoulder", "ankle"]
    },
    {
      "id": "pike",
      "metric": "pike",
      "ideal_min": -0.05,
      "tolerance": 0.07,
      "weight": 0.1,
      "severity": "technique",
      "points": ["hip", "shoulder", "ankle"],
      "unit": "scale",
      "scale": ["shoulder", "ankle"]
    },
    {
      "id": "lockout",
      "metric": "lockout",
      "ideal_min": 152.461,
      "tolerance": 15.0,
      "weight": 0.1,
      "severity": "detail",
      "points": ["shoulder", "elbow", "wrist"],
      "unit": "deg"
    },
    {
      "id": "tempo",
