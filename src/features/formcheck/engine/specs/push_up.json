  "effort_metric": "ascent_speed",
  "cues": {
    "depth": {
      "label": {
        "es": "la profundidad",
        "en": "depth"
      },
      "trend": {
        "es": "dejaste de bajar lo suficiente",
        "en": "you stopped going deep enough"
      },
      "live": {
        "es": "Pecho al suelo",
        "en": "Chest to the floor"
      },
      "fix": {
        "es": "Baja hasta que el pecho quede a un puño del suelo.",
        "en": "Lower until your chest is a fist away from the floor."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones el codo solo se dobló hasta ~{value}°, sin bajar lo suficiente.",
        "en": "In {n} of {total} reps your elbow only bent to ~{value}°, not deep enough."
      },
      "good": {
        "es": "Bajaste lo suficiente en todas las repeticiones.",
        "en": "You went deep enough on every rep."
      }
    },
    "sag": {
      "label": {
        "es": "la cadera",
        "en": "your hips"
      },
      "trend": {
        "es": "la cadera se hundió",
        "en": "your hips sagged"
      },
      "live": {
        "es": "Cuerpo de tabla",
        "en": "Plank body"
      },
      "fix": {
        "es": "Mantente rígido como una tabla de los talones a la cabeza.",
        "en": "Stay rigid like a plank from heels to head."
      },
      "finding": {
        "es": "La cadera cayó ~{mag} cm por debajo de la línea hombro–tobillo en {n} de {total} repeticiones.",
        "en": "Your hips dropped ~{mag} cm below the shoulder–ankle line in {n} of {total} reps."
      },
      "good": {
        "es": "Mantuviste el cuerpo en línea en todas las repeticiones.",
        "en": "You kept your body in line on every rep."
      }
    },
    "pike": {
      "label": {
        "es": "la cadera alta",
        "en": "high hips"
      },
      "trend": {
        "es": "subiste la cadera",
        "en": "your hips piked up"
      },
      "live": {
        "es": "Cadera abajo",
        "en": "Hips down"
      },
      "fix": {
        "es": "Baja la cadera hasta alinear hombros, cadera y tobillos.",
        "en": "Lower your hips until shoulders, hips and ankles line up."
      },
      "finding": {
        "es": "La cadera quedó ~{mag} cm por encima de la línea en {n} de {total} repeticiones.",
        "en": "Your hips stayed ~{mag} cm above the line in {n} of {total} reps."
      },
      "good": {
        "es": "No levantaste la cadera en ninguna repetición.",
        "en": "Your hips never piked up."
      }
    },
    "lockout": {
      "label": {
        "es": "el bloqueo",
        "en": "lockout"
      },
      "trend": {
        "es": "dejaste de estirar los brazos",
        "en": "you stopped locking out"
      },
      "live": {
        "es": "Brazos largos",
        "en": "Long arms"
      },
      "fix": {
        "es": "Estira los brazos del todo arriba, alejando el suelo.",
        "en": "Fully straighten your arms at the top, pushing the floor away."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones no estiraste del todo los brazos (~{value}°).",
        "en": "In {n} of {total} reps you didn't fully straighten your arms (~{value}°)."
      },
      "good": {
        "es": "Estiraste los brazos del todo en cada repetición.",
        "en": "You locked out every rep."
      }
    },
    "tempo": {
      "label": {
        "es": "el ritmo de bajada",
        "en": "your descent"
      },
      "trend": {
        "es": "bajaste más rápido",
        "en": "you dropped faster"
      },
      "live": {
        "es": "Baja en dos",
        "en": "Two counts down"
      },
      "fix": {
        "es": "Cuenta «uno, dos» mientras bajas.",
        "en": "Count «one, two» on the way down."
      },
      "finding": {
        "es": "En {n} de {total} repeticiones bajaste en ~{value} s.",
        "en": "In {n} of {total} reps you dropped in ~{value} s."
      },
      "good": {
        "es": "Bajaste con control en todas las repeticiones.",
        "en": "You lowered with control on every rep."
      }
    }
  },
